# CRM (Qualificou) - espelho dos leads da landing. Chave do tenant VBZ.
# Valor real em ~/.claude/secrets/ohanax-infra/qualificou-inbound.env
QUALIFICOU_INBOUND_URL=https://api.qualificou.com.br/api/v1/inbound/leads
QUALIFICOU_INBOUND_KEY=

# Cidades atendidas, separadas por vírgula ("Pouso Alegre-MG,Itajubá-MG").
# VAZIO = nenhum endereço é declarado disponível; a página promete conferência.
VBZ_COVERAGE_CITIES=

# Análise de crédito via Radar do Crédito. Vazio = proposta vai pra análise manual.
RADAR_API_URL=https://api.radardocredito.com.br/api/radar/v1
RADAR_API_KEY=
